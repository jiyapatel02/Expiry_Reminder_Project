<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/background"
    tools:context=".SettingsActivity">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="← Back"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_teal"
        android:backgroundTint="@color/card_white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/tvNotificationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Expiry Notifications"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp" />

    <Switch
        android:id="@+id/switchNotifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enable Notifications"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:checked="true"
        app:layout_constraintTop_toBottomOf="@id/tvNotificationLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="15dp" />

    <TextView
        android:id="@+id/tvReminderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reminder Period"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toBottomOf="@id/switchNotifications"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp" />

    <Spinner
        android:id="@+id/spReminderPeriod"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:backgroundTint="@color/primary_teal"
        app:layout_constraintTop_toBottomOf="@id/tvReminderLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/tvAbout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Digital Document Expiry Reminder&#10;&#10;This app helps you store important document details and check their expiry dates.&#10;&#10;Version 1.0"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/spReminderPeriod"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp" />

</androidx.constraintlayout.widget.ConstraintLayout>