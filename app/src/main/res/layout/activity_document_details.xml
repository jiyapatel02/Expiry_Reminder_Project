<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF9">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="←"
        android:textColor="#17201F"
        android:textSize="26sp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"/>

    <TextView
        android:id="@+id/tvPageTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Document Details"
        android:textColor="#17201F"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        android:layout_marginEnd="16dp"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/documentCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E2E9E7"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="24dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvDocumentIcon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:text="📄"
                android:textSize="28sp"
                android:background="#DDF4F0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvDocumentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Passport"
                android:textColor="#17201F"
                android:textSize="21sp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/tvDocumentIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvDocumentIcon"
                android:layout_marginStart="14dp"/>

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Government ID"
                android:textColor="#087F73"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@id/tvDocumentName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDocumentName"
                android:layout_marginTop="5dp"/>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valid"
                android:textColor="#1B9A59"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#E5F6ED"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDocumentIcon"
                android:layout_marginTop="22dp"/>

            <View
                android:id="@+id/divider"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="#E2E9E7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStatus"
                android:layout_marginTop="20dp"/>

            <TextView
                android:id="@+id/tvIssueLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Issue Date"
                android:textColor="#66716F"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider"
                android:layout_marginTop="18dp"/>

            <TextView
                android:id="@+id/tvIssueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="10 Jan 2025"
                android:textColor="#17201F"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvIssueLabel"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvExpiryLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Expiry Date"
                android:textColor="#66716F"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvIssueDate"
                android:layout_marginTop="18dp"/>

            <TextView
                android:id="@+id/tvExpiryDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="10 Jan 2035"
                android:textColor="#17201F"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvExpiryLabel"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvNotesLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Notes"
                android:textColor="#66716F"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvExpiryDate"
                android:layout_marginTop="18dp"/>

            <TextView
                android:id="@+id/tvNotes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Important document"
                android:textColor="#17201F"
                android:textSize="15sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvNotesLabel"
                android:layout_marginTop="5dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEdit"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#087F73"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardDelete"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="7dp"
        android:layout_marginBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Edit Document"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDelete"
        android:layout_width="0dp"
        android:layout_height="55dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeWidth="1dp"
        app:strokeColor="#D93636"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toEndOf="@id/cardEdit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Delete"
            android:textColor="#D93636"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>